/* Generated by build/generate.py from tokens/tokens.json. Do not edit by hand. */

QWidget#SettingsWindow { background: #F5F6FA; }
QWidget#HeaderBar      { background: #F5F6FA; min-height: 48px; }

QListWidget#Sidebar {
  background: #F7F8FA;
  min-width: 236px;
  border: none;
  border-right: 1px solid #E1E4E9;
}
QListWidget#Sidebar::item          { border-radius: 8px; padding: 7px 10px; }
QListWidget#Sidebar::item:selected { background: #E2E4E9; color: #17191D; }

QFrame#Card        { background: #FFFFFF; border-radius: 12px; }
QWidget#Row        { min-height: 44px; }
QWidget#Row:hover  { background: #E9EAEE; }
QFrame#Divider     { background: #ECEEF1; max-height: 1px; }

QPushButton {
  min-height: 36px;
  border: none;
  border-radius: 8px;
  padding: 9px 18px;
  font-weight: 500;
  background: #FFFFFF;
  color: #17191D;
}
QPushButton[primary="true"]        { background: #3385FF; color: #FFFFFF; }
QPushButton[primary="true"]:hover  { background: #2B73E6; }
QPushButton[danger="true"]         { background: #E8453C; color: #FFFFFF; }
QPushButton:disabled               { background: #EFF0F3; color: #9BA1AC; }

QLineEdit {
  background: #EFF0F3;
  border: none;
  border-radius: 8px;
  min-height: 36px;
  padding: 0 12px;
  color: #17191D;
}
QLineEdit:focus { border: 2px solid #3385FF; }

QComboBox {
  background: #EFF0F3;
  border: none;
  border-radius: 8px;
  padding: 7px 8px 7px 12px;
}
QComboBox QAbstractItemView {
  background: #FFFFFF;
  border-radius: 10px;
  selection-background-color: #E9EAEE;
}

QSlider::groove:horizontal { height: 4px; background: #D6D8DE; border-radius: 2px; }
QSlider::sub-page:horizontal { background: #3385FF; border-radius: 2px; }
QSlider::handle:horizontal {
  width: 18px;
  margin: -7px 0;
  background: #FFFFFF;
  border: 1px solid #E1E4E9;
  border-radius: 9px;
}

QMenu  { background: #FFFFFF; border: 1px solid #E1E4E9; border-radius: 10px; padding: 6px; }
QMenu::item          { border-radius: 6px; padding: 7px 10px; }
QMenu::item:selected { background: #E9EAEE; }

QLabel[badge="true"] { background: #E8F1FF; color: #3385FF; border-radius: 999px; padding: 3px 9px; }
QDialog { background: #FFFFFF; border-radius: 12px; }

QScrollBar:vertical        { background: transparent; width: 5px; }
QScrollBar::handle:vertical { background: #9BA1AC; border-radius: 3px; min-height: 40px; }
